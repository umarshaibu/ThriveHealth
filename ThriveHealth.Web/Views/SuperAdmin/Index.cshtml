@model ThriveHealth.Web.Controllers.SuperAdminController.SuperAdminDashboard
@using ThriveHealth.Web.Models.Tenancy
@{
    ViewData["Title"] = "Dashboard";
    string Tone(TenantStatus s) => s switch
    {
        TenantStatus.Trialing => "info",
        TenantStatus.Active => "success",
        TenantStatus.PendingPayment => "warning",
        TenantStatus.PastDue => "danger",
        TenantStatus.Suspended => "muted",
        TenantStatus.Cancelled => "muted",
        _ => "muted"
    };
    string KindIcon(string kind) => kind switch
    {
        "signup"            => "person-plus-fill",
        "payment-submitted" => "cash-coin",
        "payment-approved"  => "check-circle-fill",
        "payment-rejected"  => "x-circle-fill",
        "suspended"         => "pause-circle-fill",
        "domain-verified"   => "globe2",
        _                   => "circle-fill"
    };
    var mrrDelta = Model.MrrLastMonth == 0 ? 0 : (int)Math.Round((double)((Model.MrrNgn - Model.MrrLastMonth) / Model.MrrLastMonth) * 100);
    var signupDelta = Model.NewThisMonth - Model.NewLastMonth;
}

<style>
    .th-kpi-sub { font-size: 12.5px; color: var(--th-text-muted); display: flex; align-items: center; gap: 4px; margin-top: 6px; }
    .th-kpi-sub.up { color: var(--th-success); }
    .th-kpi-sub.down { color: var(--th-danger); }
    .th-kpi-sub.warn { color: var(--th-warning); }
    .th-kpi-value { font-size: 1.6rem; margin-top: 12px; }

    .th-feed { max-height: 340px; overflow-y: auto; padding-right: 4px; }
    .th-feed::-webkit-scrollbar { width: 6px; }
    .th-feed::-webkit-scrollbar-thumb { background: var(--th-border); border-radius: 4px; }
    .feed-item { display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px dashed var(--th-border); }
    .feed-item:last-child { border-bottom: 0; }
    .feed-icon { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: .8rem; }
    .feed-icon.success { background: var(--th-success-soft); color: var(--th-success); }
    .feed-icon.warning { background: var(--th-warning-soft); color: var(--th-warning); }
    .feed-icon.danger  { background: var(--th-danger-soft);  color: var(--th-danger); }
    .feed-icon.info    { background: var(--th-info-soft);    color: var(--th-info); }
    .feed-body { flex: 1; min-width: 0; }
    .feed-title { font-size: .88rem; color: var(--th-text); overflow-wrap: anywhere; }
    .feed-detail { font-size: .75rem; color: var(--th-text-muted); overflow-wrap: anywhere; }
    .feed-time { font-size: .72rem; color: var(--th-text-muted); white-space: nowrap; }

    .health-row { display: flex; justify-content: space-between; gap: 8px; padding: 8px 0; border-bottom: 1px dashed var(--th-border); font-size: .85rem; }
    .health-row:last-child { border-bottom: 0; }
    .health-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
    .health-dot.green { background: var(--th-success); }
    .health-dot.amber { background: var(--th-warning); }
    .health-dot.red   { background: var(--th-danger); }

    .at-risk-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 0; border-bottom: 1px dashed var(--th-border); }
    .at-risk-row:last-child { border-bottom: 0; }
    .at-risk-name { font-size: .88rem; color: var(--th-text); overflow-wrap: anywhere; }
    .at-risk-meta { font-size: .72rem; color: var(--th-text-muted); }
    .plan-swatch { background: var(--th-chart-1); }
    .plan-swatch.c1 { background: var(--th-chart-2); } .plan-swatch.c2 { background: var(--th-chart-3); }
    .plan-swatch.c3 { background: var(--th-chart-4); } .plan-swatch.c4 { background: var(--th-chart-5); }
</style>

<div class="th-page-head">
    <div>
        <h1 class="th-section-title">Platform overview</h1>
        <p class="th-section-sub">Tenants, billing and operations across all hospitals running on ThriveHealth.</p>
    </div>
</div>

@* ---------- KPI ROW ---------- *@
<div class="row g-3 mb-4">
    <div class="col-md-2 col-6"><div class="th-stat">
        <span class="th-stat-label d-block">Tenants</span>
        <span class="th-stat-value th-kpi-value d-block">@Model.TotalTenants</span>
        @if (Model.NewThisMonth > 0)
        { <span class="th-kpi-sub up"><i class="bi bi-arrow-up"></i> @Model.NewThisMonth this month</span> }
        else
        { <span class="th-kpi-sub">no new this month</span> }
    </div></div>
    <div class="col-md-2 col-6"><div class="th-stat">
        <span class="th-stat-label d-block">Trialing</span>
        <span class="th-stat-value th-kpi-value d-block">@Model.Trialing</span>
        <span class="th-kpi-sub">awaiting conversion</span>
    </div></div>
    <div class="col-md-2 col-6"><div class="th-stat">
        <span class="th-stat-label d-block">Paying</span>
        <span class="th-stat-value th-kpi-value d-block">@Model.Active</span>
        <span class="th-kpi-sub up">active subscriptions</span>
    </div></div>
    <div class="col-md-2 col-6"><div class="th-stat">
        <span class="th-stat-label d-block">MRR</span>
        <span class="th-stat-value th-kpi-value d-block">₦@Model.MrrNgn.ToString("N0")</span>
        @if (mrrDelta > 0) { <span class="th-kpi-sub up"><i class="bi bi-arrow-up"></i> @mrrDelta% vs last mo</span> }
        else if (mrrDelta < 0) { <span class="th-kpi-sub down"><i class="bi bi-arrow-down"></i> @Math.Abs(mrrDelta)% vs last mo</span> }
        else { <span class="th-kpi-sub">flat vs last mo</span> }
    </div></div>
    <div class="col-md-2 col-6"><div class="th-stat">
        <span class="th-stat-label d-block">ARR run-rate</span>
        <span class="th-stat-value th-kpi-value d-block">₦@Model.ArrNgn.ToString("N0")</span>
        <span class="th-kpi-sub">annualised MRR × 12</span>
    </div></div>
    <div class="col-md-2 col-6"><div class="th-stat">
        <span class="th-stat-label d-block">Pending review</span>
        <span class="th-stat-value th-kpi-value d-block">@(Model.PendingPayments + Model.PendingDomainVerifications)</span>
        <span class="th-kpi-sub @(Model.PendingPayments > 0 ? "warn" : "")">
            @Model.PendingPayments payments · @Model.PendingDomainVerifications domains
        </span>
    </div></div>
</div>

@* ---------- CHARTS ROW ---------- *@
<div class="row g-3 mb-4">
    <div class="col-lg-8"><div class="th-card th-card-body">
        <div class="th-card-title d-flex justify-content-between align-items-center flex-wrap gap-1 mb-3">
            <span>Tenant signups · last 6 months</span>
            <span class="small fw-medium" style="color:var(@(signupDelta >= 0 ? "--th-success" : "--th-danger"));">
                @(signupDelta >= 0 ? "+" : "")@signupDelta vs previous month
            </span>
        </div>
        <div style="position: relative; height: 240px;">
            <canvas id="signupChart"></canvas>
        </div>
    </div></div>
    <div class="col-lg-4"><div class="th-card th-card-body">
        <div class="th-card-title mb-3">Plan distribution</div>
        @if (Model.PlanShares.Any())
        {
            <div style="position: relative; height: 200px;">
                <canvas id="planChart"></canvas>
            </div>
            <div class="mt-3 small">
                @foreach (var p in Model.PlanShares.Select((x, i) => new { x.Plan, x.Count, x.MrrShare, I = i % 5 }))
                {
                    <div class="d-flex justify-content-between py-1" style="border-bottom: 1px dashed var(--th-border);">
                        <span><span class="health-dot plan-swatch c@(p.I)"></span>@p.Plan</span>
                        <span class="text-muted">@p.Count tenants · ₦@p.MrrShare.ToString("N0")/mo</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted small mb-0">No active subscriptions yet.</p>
        }
    </div></div>
</div>

@* ---------- ACTIVITY + HEALTH + AT-RISK ROW ---------- *@
<div class="row g-3 mb-4">
    <div class="col-lg-5"><div class="th-card th-card-body">
        <div class="th-card-title mb-3">Recent activity · last 30 days</div>
        @if (Model.RecentActivity.Any())
        {
            <div class="th-feed">
                @foreach (var a in Model.RecentActivity)
                {
                    <div class="feed-item">
                        <div class="feed-icon @a.Tone"><i class="bi bi-@KindIcon(a.Kind)"></i></div>
                        <div class="feed-body">
                            <div class="feed-title">@a.Title</div>
                            @if (!string.IsNullOrEmpty(a.Detail)) { <div class="feed-detail">@a.Detail</div> }
                        </div>
                        <div class="feed-time">@a.At.ToString("dd MMM HH:mm")</div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted small mb-0">Quiet — no platform activity in the last 30 days.</p>
        }
    </div></div>

    <div class="col-lg-4"><div class="th-card th-card-body h-100">
        <div class="th-card-title mb-3">At-risk tenants</div>
        @if (Model.AtRiskTenants.Any())
        {
            @foreach (var t in Model.AtRiskTenants)
            {
                <div class="at-risk-row">
                    <div>
                        <div class="at-risk-name">@t.LegalName</div>
                        <div class="at-risk-meta">@t.Slug</div>
                    </div>
                    <div class="text-end">
                        @if (t.Status == TenantStatus.Trialing && t.TrialEndsAt.HasValue)
                        {
                            var days = (int)Math.Ceiling((t.TrialEndsAt.Value - DateTime.UtcNow).TotalDays);
                            <span class="th-pill th-pill-warning">trial · @days d left</span>
                        }
                        else
                        {
                            <span class="th-pill th-pill-danger">past due</span>
                        }
                        <a asp-controller="SuperAdminTenants" asp-action="Detail" asp-route-id="@t.Id" class="d-block small mt-1">open →</a>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted small mb-0">No tenants currently at risk.</p>
        }
    </div></div>

    <div class="col-lg-3"><div class="th-card th-card-body h-100">
        <div class="th-card-title mb-3">System health</div>
        <div class="health-row">
            <span><span class="health-dot green"></span>Database</span>
            <span class="text-muted small">connected</span>
        </div>
        <div class="health-row">
            <span><span class="health-dot @(Model.PendingPayments == 0 ? "green" : Model.PendingPayments > 5 ? "red" : "amber")"></span>Pending payments</span>
            <span class="text-muted small">@Model.PendingPayments queued</span>
        </div>
        <div class="health-row">
            <span><span class="health-dot @(Model.PendingDomainVerifications == 0 ? "green" : "amber")"></span>Domain verifications</span>
            <span class="text-muted small">@Model.PendingDomainVerifications pending</span>
        </div>
        <div class="health-row">
            <span><span class="health-dot @(Model.PastDue == 0 ? "green" : Model.PastDue > 3 ? "red" : "amber")"></span>Past-due tenants</span>
            <span class="text-muted small">@Model.PastDue</span>
        </div>
        <div class="health-row">
            <span><span class="health-dot @(Model.Suspended == 0 ? "green" : "amber")"></span>Suspended</span>
            <span class="text-muted small">@Model.Suspended</span>
        </div>
        <div class="health-row">
            <span><span class="health-dot green"></span>Lifecycle sweep</span>
            <span class="text-muted small">hourly</span>
        </div>
    </div></div>
</div>

@* ---------- RECENT SIGNUPS TABLE ---------- *@
<div class="th-page-head mb-2">
    <h2 class="th-section-title">Recent signups</h2>
    <div class="th-page-actions"><a asp-controller="SuperAdminTenants" asp-action="Index" class="small">View all tenants →</a></div>
</div>
<div class="th-card th-table-flush">
    <div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Tenant</th><th>Owner</th><th>Status</th><th>Country</th><th>Created</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in Model.RecentTenants)
            {
                <tr>
                    <td><strong>@t.LegalName</strong><div class="small text-muted">@(t.CustomDomain ?? t.Slug + ".thrivehealth.ng")</div></td>
                    <td>@t.OwnerName<div class="small text-muted">@t.OwnerEmail</div></td>
                    <td><span class="th-pill th-pill-@Tone(t.Status)">@t.Status</span></td>
                    <td>@(t.IsTeachingHospital ? "Teaching (free)" : t.CountryCode)</td>
                    <td class="small">@t.CreatedAt.ToString("dd MMM HH:mm")</td>
                    <td><a asp-controller="SuperAdminTenants" asp-action="Detail" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Open</a></td>
                </tr>
            }
            @if (!Model.RecentTenants.Any()) { <tr><td colspan="6" class="text-center py-4 text-muted">No tenants yet.</td></tr> }
        </tbody>
    </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    const css = getComputedStyle(document.documentElement);
    const tok = n => css.getPropertyValue(n).trim();
    const chartColors = [1, 2, 3, 4, 5].map(i => tok('--th-chart-' + i));
    Chart.defaults.color = tok('--th-text-muted');
    Chart.defaults.borderColor = tok('--th-border');
    Chart.defaults.font.family = 'Inter, system-ui, sans-serif';

    new Chart(document.getElementById('signupChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SignupTrend.Select(p => p.Label))),
            datasets: [{
                label: 'New tenants',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SignupTrend.Select(p => p.Count))),
                backgroundColor: chartColors[0],
                borderWidth: 0,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false } },
                y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1 } }
            }
        }
    });

    @if (Model.PlanShares.Any())
    {
        <text>
        new Chart(document.getElementById('planChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanShares.Select(p => p.Plan))),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanShares.Select(p => p.Count))),
                    backgroundColor: chartColors,
                    borderColor: tok('--th-surface'), borderWidth: 2
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                cutout: '65%',
                plugins: { legend: { display: false } }
            }
        });
        </text>
    }
</script>
}

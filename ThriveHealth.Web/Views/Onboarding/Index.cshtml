@using ThriveHealth.Web.Models.Tenancy
@{
    ViewData["Title"] = "Modern hospital management for Nigerian healthcare";
    var plans = (List<Plan>)ViewBag.Plans;
}

<style>
    .th-hero { background: var(--th-navy); color: #fff; margin: 16px; border-radius: 28px; padding: 88px 24px 96px; }
    .th-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 600; line-height: 1.1; letter-spacing: -.03em; max-width: 880px; margin: 0 auto 18px; text-align: center; }
    .th-hero p.lead { font-size: 1.1rem; line-height: 1.55; color: #d3d9e2; max-width: 720px; margin: 0 auto; text-align: center; }
    .th-hero .cta-row { display: flex; gap: 12px; justify-content: center; margin-top: 32px; flex-wrap: wrap; }
    .th-hero .btn-cta { background: #fff; color: var(--th-navy); padding: 12px 26px; border-radius: 999px; font-weight: 600; }
    .th-hero .btn-cta:hover { background: var(--th-navy-soft); color: var(--th-navy); }
    .th-hero .btn-ghost { background: transparent; color: #fff; padding: 12px 26px; border-radius: 999px; font-weight: 500; border: 1px solid rgba(255,255,255,.4); }
    .th-hero .btn-ghost:hover { background: rgba(255,255,255,.1); color: #fff; }
    .btn-cta { display: inline-block; background: #fff; color: var(--th-navy); padding: 12px 26px; border-radius: 999px; font-weight: 600; }
    .th-section { padding: 72px 24px; }
    .th-section h2 { font-size: 2rem; font-weight: 600; letter-spacing: -.025em; text-align: center; margin-bottom: 14px; }
    .th-section p.sub { font-size: 1.05rem; color: var(--th-text-muted); text-align: center; max-width: 640px; margin: 0 auto 44px; }
    .th-features { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 16px; max-width: 1200px; margin: 0 auto; }
    .th-feature { background: var(--th-surface); border-radius: var(--th-radius); padding: 24px; }
    .th-feature .icon { width: 44px; height: 44px; background: var(--th-surface-alt); color: var(--th-text-muted); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; margin-bottom: 14px; }
    .th-feature h5 { font-weight: 600; font-size: 1.05rem; margin-bottom: 6px; }
    .th-feature p { color: var(--th-text-muted); font-size: 14px; line-height: 1.5; margin: 0; }
    .th-pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; max-width: 1200px; margin: 0 auto; }
    .th-plan { background: var(--th-surface); border-radius: var(--th-radius); padding: 24px; display: flex; flex-direction: column; position: relative; }
    .th-plan.featured { background: var(--th-navy); color: #fff; }
    .th-plan.featured::before { content: "Most popular"; position: absolute; top: 16px; right: 16px; background: var(--th-emerald-soft); color: var(--th-emerald); font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; }
    .th-plan h4 { font-weight: 600; font-size: 1.15rem; margin-bottom: 4px; }
    .th-plan .tagline { color: var(--th-text-muted); font-size: 13px; min-height: 36px; margin-bottom: 14px; }
    .th-plan.featured .tagline, .th-plan.featured .text-muted, .th-plan.featured .price small { color: #c3cbd6 !important; }
    .th-plan .price { font-size: 2rem; font-weight: 600; letter-spacing: -.03em; margin-bottom: 2px; }
    .th-plan .price small { font-size: .9rem; font-weight: 500; color: var(--th-text-muted); }
    .th-plan ul { list-style: none; padding: 0; margin: 18px 0; flex: 1; font-size: 13.5px; }
    .th-plan ul li { padding: 6px 0; color: var(--th-text-muted); border-bottom: 1px solid var(--th-border); display: flex; align-items: center; gap: 8px; }
    .th-plan.featured ul li { color: #e6eaf0; border-color: rgba(255,255,255,.14); }
    .th-plan ul li i { color: var(--th-emerald); }
    .th-plan.featured ul li i { color: #7fd8b0; }
    .th-plan ul li.no, .th-plan ul li.no i { color: var(--th-text-faint); }
    .th-plan .pick { display: block; text-align: center; padding: 11px; border-radius: 999px; background: var(--th-surface-sunken); color: var(--th-text); font-weight: 500; }
    .th-plan .pick:hover { background: var(--th-border); }
    .th-plan.featured .pick { background: #fff; color: var(--th-navy); }
    .th-plan.featured .pick:hover { background: var(--th-navy-soft); }
    @@media (max-width: 575.98px) { .th-hero { margin: 12px; padding: 56px 20px 64px; border-radius: 22px; } .th-section { padding: 48px 16px; } }
</style>

<section class="th-hero">
    <h1>The operating system for modern hospitals.</h1>
    <p class="lead">Patient records · Telemedicine · Lab &amp; pharmacy · HMO claims · AI triage. One platform, built for Nigerian healthcare. 30-day free trial — no credit card required.</p>
    <div class="cta-row">
        <a class="btn-cta" href="/signup">Start your free trial <i class="bi bi-arrow-right ms-1"></i></a>
        <a class="btn-ghost" href="/pricing">See pricing</a>
    </div>
</section>

<section class="th-section" id="features">
    <h2>Everything your hospital runs on, in one place.</h2>
    <p class="sub">Replace the patchwork of paper, Excel and ad-hoc tools. ThriveHealth ties patient registration, clinical care, billing and claims into one auditable system.</p>
    <div class="th-features">
        <div class="th-feature"><div class="icon"><i class="bi bi-person-badge"></i></div><h5>Patient EMR</h5><p>Single source of truth — visits, prescriptions, allergies, results, all linked to the patient's hospital number.</p></div>
        <div class="th-feature"><div class="icon"><i class="bi bi-camera-video"></i></div><h5>Telemedicine</h5><p>Video, audio &amp; chat consults built in. Pay-per-consult or 24-hour chat package. Encrypted, no signup for the patient.</p></div>
        <div class="th-feature"><div class="icon"><i class="bi bi-droplet-half"></i></div><h5>Lab &amp; imaging</h5><p>Order from any consultation; results post back automatically. Critical-value alerts. Patient sees their results on the portal.</p></div>
        <div class="th-feature"><div class="icon"><i class="bi bi-prescription2"></i></div><h5>Pharmacy</h5><p>Formulary, dispensing, stock movement, allergy checks. Pre-built drug interaction warnings.</p></div>
        <div class="th-feature"><div class="icon"><i class="bi bi-cash-stack"></i></div><h5>Billing &amp; claims</h5><p>Cash, POS, transfer, mobile money. NHIA/HMO claims auto-built from completed consultations.</p></div>
        <div class="th-feature"><div class="icon"><i class="bi bi-stars"></i></div><h5>AI assists</h5><p>Symptom triage, lab interpretation, ICD coding, drug-interaction checks — gated, audited, never replaces a clinician.</p></div>
        <div class="th-feature"><div class="icon"><i class="bi bi-shield-lock"></i></div><h5>NDPA-ready</h5><p>PHI scrubbed before any AI call. Full audit log. Fine-grained role permissions edited by hospital admin.</p></div>
        <div class="th-feature"><div class="icon"><i class="bi bi-people"></i></div><h5>Patient portal</h5><p>Your patients book, pay, chat, view results, download receipts. PWA installable on Android &amp; iOS.</p></div>
    </div>
</section>

<section class="th-section" id="pricing">
    <h2>Simple pricing, no surprises.</h2>
    <p class="sub">Pay monthly or save 20% with annual billing. All plans include the 30-day free trial. Teaching hospitals are free — just verify your status during signup.</p>
    <div class="th-pricing-grid">
        @foreach (var p in plans.Where(x => x.Code != "trial"))
        {
            var featured = p.Code == "standard";
            <div class="th-plan @(featured ? "featured" : "")">
                <h4>@p.Name</h4>
                <div class="tagline">@p.Tagline</div>
                @if (p.IsCustomQuote)
                {
                    <div class="price">Custom <small>contact sales</small></div>
                }
                else
                {
                    <div class="price">₦@p.MonthlyNgn.ToString("N0") <small>/ month</small></div>
                    <div class="small text-muted">or ₦@p.AnnualNgn.ToString("N0")/yr (save 20%)</div>
                }
                <ul>
                    <li><i class="bi bi-check2"></i> Up to @(p.MaxStaff?.ToString("N0") ?? "Unlimited") staff</li>
                    <li><i class="bi bi-check2"></i> @(p.MaxPatientsPerMonth?.ToString("N0") ?? "Unlimited") patients/mo</li>
                    <li class="@(p.TelemedicineEnabled ? "" : "no")"><i class="bi @(p.TelemedicineEnabled ? "bi-check2" : "bi-x")"></i> Telemedicine</li>
                    <li class="@(p.AiEnabled ? "" : "no")"><i class="bi @(p.AiEnabled ? "bi-check2" : "bi-x")"></i> AI features</li>
                    <li class="@(p.MultiFacilityEnabled ? "" : "no")"><i class="bi @(p.MultiFacilityEnabled ? "bi-check2" : "bi-x")"></i> Multi-facility</li>
                    <li class="@(p.ClaimsEnabled ? "" : "no")"><i class="bi @(p.ClaimsEnabled ? "bi-check2" : "bi-x")"></i> HMO/NHIA claims</li>
                    <li class="@(p.PrioritySupport ? "" : "no")"><i class="bi @(p.PrioritySupport ? "bi-check2" : "bi-x")"></i> Priority support</li>
                </ul>
                <a class="pick" asp-action="SignUp" asp-route-plan="@p.Code">@(p.IsCustomQuote ? "Talk to sales" : "Start free trial")</a>
            </div>
        }
    </div>
</section>

<section class="th-section th-hero" id="contact" style="text-align: center; padding-top: 56px; padding-bottom: 56px;">
    <h2 style="color: #fff;">Ready to modernise your hospital?</h2>
    <p style="color: #d3d9e2; max-width: 540px; margin: 0 auto 28px;">30-day free trial, no credit card. Sign up in 2 minutes — your workspace is ready instantly.</p>
    <a class="btn-cta" href="/signup">Start your free trial</a>
</section>

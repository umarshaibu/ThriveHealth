@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · ThriveHealth</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body { height: auto; }
        .th-topnav { padding: 14px 28px; display: flex; justify-content: space-between; align-items: center; gap: 12px; background: var(--th-surface); position: sticky; top: 0; z-index: 50; }
        .th-topnav .brand { font-weight: 700; font-size: 1.1rem; letter-spacing: -.02em; color: var(--th-text); display: inline-flex; align-items: center; gap: 10px; }
        .th-topnav .links a { color: var(--th-text-muted); margin: 0 14px; font-weight: 500; }
        .th-topnav .links a:hover { color: var(--th-text); }
        .th-foot { padding: 32px 20px; color: var(--th-text-muted); font-size: 13px; text-align: center; background: var(--th-surface); margin-top: 48px; }
        @@media (max-width: 575.98px) { .th-topnav { padding: 12px 16px; } }
    </style>
</head>
<body>
    <nav class="th-topnav">
        <a class="brand" href="/"><span class="th-logo" style="width:34px;height:34px;border-radius:11px;font-size:1rem;"><i class="bi bi-heart-pulse-fill"></i></span> ThriveHealth</a>
        <div class="links d-none d-md-block">
            <a href="/pricing">Pricing</a>
            <a href="/#features">Features</a>
            <a href="/#contact">Contact</a>
        </div>
        <a class="btn btn-primary" href="/signup">Start free trial</a>
    </nav>

    @RenderBody()

    <footer class="th-foot">
        &copy; @DateTime.Now.Year ThriveHealth · Multi-tenant hospital management platform · Built for Nigerian healthcare
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

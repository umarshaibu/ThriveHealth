@model ThriveHealth.Web.Models.ViewModels.PortalLoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<style>
    /* _AuthLayout has no portal body class, so emerald is set here for this page. */
    .th-auth.th-auth-portal {
        --th-primary: var(--th-emerald);
        --th-primary-rgb: 11, 122, 79;
        --th-primary-hover: var(--th-emerald-hover);
        --th-primary-soft: var(--th-emerald-soft);
        --bs-primary: var(--th-emerald);
        --bs-primary-rgb: 11, 122, 79;
    }
    .th-auth-portal .th-auth-art { background: var(--th-emerald); }
    .th-auth-portal .th-auth-art .th-logo { background: var(--th-surface); color: var(--th-emerald); }
    .th-auth-portal .th-auth-pitch p { color: var(--th-surface); opacity: .92; }
    .th-auth-portal .th-auth-feature { background: rgba(var(--th-primary-rgb), .55); }
    .th-auth-portal .th-auth-feature i { color: var(--th-surface); }
    .th-auth-portal .th-auth-feature .label { color: var(--th-surface); opacity: .92; }
    .th-auth-portal .th-auth-features { grid-template-columns: 1fr; }
    .th-auth-portal .th-auth-form .form-control { padding: .7rem .9rem; font-size: 16px; }
    .th-auth-portal .th-auth-form .btn-primary { padding: .8rem; font-weight: 600; }
    .th-auth-portal .input-group-pw { position: relative; }
    .th-auth-portal .input-group-pw .form-control { padding-right: 48px; }
    .th-auth-portal .toggle-pw { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; background: transparent; border: 0; color: var(--th-text-muted); cursor: pointer; z-index: 5; }
    .th-auth-portal .toggle-pw:hover { color: var(--th-primary); }
    .th-auth-portal .th-auth-mobile-brand { display: none; }
    .th-auth-portal .th-auth-divider { display: flex; align-items: center; gap: 12px; color: var(--th-text-muted); font-size: 13px; margin: 24px 0 14px; }
    .th-auth-portal .th-auth-divider::before, .th-auth-portal .th-auth-divider::after { content: ""; height: 1px; background: var(--th-border); flex: 1; }
    .th-auth-portal .th-auth-staff-link { text-align: center; margin-top: 18px; font-size: 13px; color: var(--th-text-muted); }
    .th-auth-portal .th-auth-staff-link a { color: var(--th-text); border-bottom: 1px dotted var(--th-border-strong); }
    @@media (max-width: 991.98px) {
        .th-auth-portal .th-auth-mobile-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; justify-content: center; margin-bottom: 20px; }
        .th-auth-portal .th-auth-form-wrap { padding: 24px 16px 40px; align-items: flex-start; }
        .th-auth-portal .th-auth-form { padding: 24px; }
    }
</style>

<div class="th-auth th-auth-portal">
    <div class="th-auth-art">
        <div class="th-auth-art-brand">
            <span class="th-logo"><i class="bi bi-heart-pulse-fill"></i></span>
            <span class="fw-bold fs-5">ThriveHealth</span>
        </div>

        <div class="th-auth-pitch">
            <h1>Your health, in your pocket.</h1>
            <p>Book consultations, chat with your doctor, view results and pay your bills, all from one secure portal.</p>

            <div class="th-auth-features">
                <div class="th-auth-feature">
                    <i class="bi bi-camera-video-fill"></i>
                    <div class="value">Tele-consult anywhere</div>
                    <div class="label">Video, audio or chat. Pay in-app and see your doctor.</div>
                </div>
                <div class="th-auth-feature">
                    <i class="bi bi-clipboard2-pulse-fill"></i>
                    <div class="value">Records that travel with you</div>
                    <div class="label">Visits, prescriptions and lab results in one place.</div>
                </div>
                <div class="th-auth-feature">
                    <i class="bi bi-shield-lock-fill"></i>
                    <div class="value">Private and secure</div>
                    <div class="label">Your messages and data are protected.</div>
                </div>
            </div>
        </div>

        <div class="small"><i class="bi bi-shield-check me-1"></i> Powered by ThriveHealth</div>
    </div>

    <div class="th-auth-form-wrap">
        <div class="th-auth-form">
            <div class="th-auth-mobile-brand"><span class="th-logo"><i class="bi bi-heart-pulse-fill"></i></span><span>ThriveHealth</span></div>
            <h2>Welcome back</h2>
            <p class="subtitle">Sign in to manage your care.</p>

            <form asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" type="email" class="form-control" autofocus autocomplete="username" placeholder="you@email.com" />
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group-pw">
                        <input id="th-pw" asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="Your password" />
                        <button type="button" class="toggle-pw" id="th-pw-toggle" aria-label="Show password"><i class="bi bi-eye"></i></button>
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Keep me signed in on this device</label>
                </div>

                <button class="btn btn-primary btn-lg w-100" type="submit">Sign in <i class="bi bi-arrow-right ms-1"></i></button>
            </form>

            <div class="th-auth-divider">First time here?</div>
            <div class="text-center">
                <a asp-action="Register" class="fw-semibold"><i class="bi bi-person-plus me-1"></i> Create your portal account</a>
            </div>

            <div class="th-auth-staff-link">
                Are you a clinician or staff member? <a asp-controller="Account" asp-action="Login">Open the clinical app</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var btn = document.getElementById('th-pw-toggle');
    var pw = document.getElementById('th-pw');
    if (!btn || !pw) return;
    btn.addEventListener('click', function () {
        var hidden = pw.type === 'password';
        pw.type = hidden ? 'text' : 'password';
        btn.querySelector('i').className = hidden ? 'bi bi-eye-slash' : 'bi bi-eye';
        btn.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
    });
})();
</script>
}

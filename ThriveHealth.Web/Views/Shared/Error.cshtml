@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<div class="@(signedIn ? "" : "th-public-page")">
    <div class="th-card" style="max-width: 560px; margin: 8vh auto 0;">
        <div class="th-card-body text-center" style="padding: 40px 32px;">
            <div class="th-stat-icon position-static mb-3" style="background: var(--th-danger-soft); color: var(--th-danger);" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></div>
            <h1 class="th-section-title" style="font-size: 1.5rem;">Something went wrong</h1>
            <p class="th-section-sub">We couldn't complete that request. Your saved work isn't affected. Please try again.</p>
            <a href="/" class="btn btn-primary">Back to home</a>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted mt-4 mb-0">If this keeps happening, give support this reference: <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</div>

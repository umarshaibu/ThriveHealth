@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · ThriveHealth Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .th-admin-tag { display: inline-block; margin-left: 6px; padding: 2px 8px; border-radius: 999px; background: var(--th-danger-soft); color: var(--th-danger); font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; vertical-align: middle; }
        .th-nav-signout { width: 100%; background: transparent; border: 0; text-align: left; cursor: pointer; }
        .th-topbar-admin { display: flex; align-items: center; gap: 8px; font-weight: 600; }
        .th-table-flush { padding: 0; overflow: hidden; }
        .th-table-flush .table { margin-bottom: 0; }
        .th-code-box { word-break: break-all; }
        .th-filter-chip { padding: 6px 14px; border-radius: 999px; font-size: 13px; border: 1px solid var(--th-border-strong); color: var(--th-text-muted); background: var(--th-surface); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
        .th-filter-chip:hover { background: var(--th-surface-alt); color: var(--th-text); }
        .th-filter-chip.active { background: var(--th-primary); color: #fff; border-color: var(--th-primary); }
        .th-filter-chip .count { background: var(--th-surface-sunken); color: var(--th-text-muted); padding: 1px 8px; border-radius: 999px; font-size: 11px; }
        .th-filter-chip.active .count { background: rgba(255,255,255,.2); color: #fff; }
        .th-main, .th-content { min-width: 0; }
        .th-content { overflow-x: hidden; }
    </style>
</head>
<body class="th-app">
<aside class="th-sidebar" id="thSidebar">
    <div class="th-brand">
        <span class="th-logo"><i class="bi bi-shield-fill-check"></i></span>
        <div>
            <div class="th-brand-name">ThriveHealth <span class="th-admin-tag">Admin</span></div>
            <div class="th-brand-tag">Platform console</div>
        </div>
    </div>
    <nav class="th-nav">
        <div class="th-nav-section">Operations</div>
        <a asp-controller="SuperAdmin" asp-action="Index" class="th-nav-link"><i class="bi bi-grid-1x2"></i> Dashboard</a>
        <a asp-controller="SuperAdminActivity" asp-action="Index" class="th-nav-link"><i class="bi bi-activity"></i> Activity log</a>

        <div class="th-nav-section">Tenants</div>
        <a asp-controller="SuperAdminTenants" asp-action="Index" class="th-nav-link"><i class="bi bi-building"></i> All tenants</a>
        <a asp-controller="SuperAdminPayments" asp-action="Index" class="th-nav-link"><i class="bi bi-receipt"></i> Bank-transfer review</a>

        <div class="th-nav-section">Identity</div>
        <a asp-controller="SuperAdminUsers" asp-action="Index" class="th-nav-link"><i class="bi bi-people-fill"></i> All users</a>

        <div class="th-nav-section">Catalogue</div>
        <a asp-controller="SuperAdminPlans" asp-action="Index" class="th-nav-link"><i class="bi bi-stack"></i> Subscription plans</a>

        <div class="th-nav-section">Platform</div>
        <a asp-controller="SuperAdminAi" asp-action="Index" class="th-nav-link"><i class="bi bi-robot"></i> AI providers</a>
    </nav>
    <div class="th-sidebar-footer">
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="th-nav-link th-nav-signout"><i class="bi bi-box-arrow-right"></i> Sign out</button>
        </form>
    </div>
</aside>
<button type="button" class="th-scrim" aria-label="Close menu" onclick="thToggleSidebar()"></button>

<main class="th-main">
    <header class="th-topbar">
        <button class="btn btn-light th-sidebar-toggle d-lg-none" type="button" aria-label="Open menu" onclick="thToggleSidebar()">
            <i class="bi bi-list"></i>
        </button>
        <div class="th-topbar-admin"><i class="bi bi-shield-fill-check"></i> Admin console</div>
    </header>
    <div class="th-content">
        @if (TempData["Success"] is string okMsg)
        {
            <div class="alert alert-success d-flex align-items-center"><i class="bi bi-check-circle me-2"></i>@okMsg</div>
        }
        @if (TempData["Error"] is string errMsg)
        {
            <div class="alert alert-warning d-flex align-items-center"><i class="bi bi-exclamation-triangle me-2"></i>@errMsg</div>
        }
        @RenderBody()
    </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function thToggleSidebar() {
        document.getElementById('thSidebar')?.classList.toggle('open');
    }
    (function () {
        function norm(p) { p = (p || '/').replace(/\/+$/, ''); return (p === '' ? '/' : p).toLowerCase(); }
        var path = norm(window.location.pathname), best = null, bestLen = -1;
        document.querySelectorAll('.th-nav .th-nav-link').forEach(function (a) {
            var lp = norm(new URL(a.href, window.location.origin).pathname);
            var hit = lp === path || path.indexOf(lp + '/') === 0;
            if (hit && lp.length > bestLen) { best = a; bestLen = lp.length; }
        });
        if (best) { best.classList.add('active'); best.setAttribute('aria-current', 'page'); }
    })();
</script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

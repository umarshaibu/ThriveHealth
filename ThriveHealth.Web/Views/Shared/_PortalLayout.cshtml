@{
    var patientName = User.Identity?.Name;
    var isAuthed = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] · ThriveHealth Portal</title>
    <meta name="theme-color" content="#f1f3f2" />
    <link rel="manifest" href="~/portal/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/portal/icons/icon-192.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="th-portal">
    @if (isAuthed)
    {
        <header class="th-portal-nav">
            <a asp-controller="Portal" asp-action="Index" class="th-portal-brand"><span class="th-logo"><i class="bi bi-heart-pulse-fill"></i></span><span>ThriveHealth</span></a>
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted d-none d-md-inline">@patientName</span>
                <form asp-controller="Portal" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="th-round-btn" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i></button>
                </form>
            </div>
        </header>
    }

    <main class="th-portal-main">
        @RenderBody()
    </main>

    @if (isAuthed)
    {
        var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        <nav class="th-portal-tabbar">
            <a asp-controller="Portal" asp-action="Index" class="@(current == "Index" ? "active" : "")"><i class="bi bi-house"></i> Home</a>
            <a asp-controller="Portal" asp-action="Appointments" class="@(current == "Appointments" ? "active" : "")"><i class="bi bi-calendar2-week"></i> Visits</a>
            <a asp-controller="Portal" asp-action="Telemed" class="@(current == "Telemed" ? "active" : "")"><i class="bi bi-camera-video"></i> Telemed</a>
            <a asp-controller="Portal" asp-action="Chats" class="@(current == "Chats" || current == "Chat" ? "active" : "")"><i class="bi bi-chat-dots"></i> Chats</a>
            <a asp-controller="Portal" asp-action="Results" class="@(current == "Results" ? "active" : "")"><i class="bi bi-droplet-half"></i> Results</a>
            <a asp-controller="Portal" asp-action="Bills" class="@(current == "Bills" ? "active" : "")"><i class="bi bi-receipt"></i> Bills</a>
        </nav>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/portal/service-worker.js').catch(()=>{});
        }
    </script>
<script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model ThriveHealth.Web.Models.Tenancy.Tenant
@using ThriveHealth.Web.Models.Tenancy
@{
    ViewData["Title"] = Model.LegalName;
    var sub = ViewBag.Subscription as TenantSubscription;
    var payments = (List<TenantPayment>)ViewBag.Payments;
    var facilities = (List<ThriveHealth.Web.Models.Identity.Facility>)ViewBag.Facilities;
    string Tone(TenantStatus st) => st switch
    {
        TenantStatus.Trialing => "info",
        TenantStatus.Active => "success",
        TenantStatus.PendingPayment => "warning",
        TenantStatus.PastDue => "danger",
        _ => "muted"
    };
}

<a asp-action="Index" class="small">← Back to all tenants</a>

<div class="th-page-head mt-2">
    <div>
        <h1 class="th-section-title">@Model.LegalName</h1>
        <p class="th-section-sub">@(Model.CustomDomain ?? Model.Slug + ".thrivehealth.ng") · @Model.CountryCode · @Model.CurrencyCode</p>
    </div>
    <div class="th-page-actions text-end">
        <span class="th-pill th-pill-@Tone(Model.Status)">@Model.Status</span>
        @if (Model.IsTeachingHospital) { <div class="small mt-1" style="color: var(--th-info);">Verified teaching hospital</div> }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6"><div class="th-stat"><div class="th-stat-label">Owner</div><div style="margin-top:12px; overflow-wrap:anywhere;">@Model.OwnerName<br/><span class="small text-muted">@Model.OwnerEmail</span></div></div></div>
    <div class="col-md-3 col-6"><div class="th-stat"><div class="th-stat-label">Trial ends</div><div class="th-stat-value" style="font-size: 1.2rem;">@(Model.TrialEndsAt?.ToString("dd MMM yyyy") ?? "—")</div></div></div>
    <div class="col-md-3 col-6"><div class="th-stat"><div class="th-stat-label">Plan</div><div class="th-stat-value" style="font-size: 1.2rem;">@(sub?.Plan?.Name ?? "—")<div class="small text-muted">@sub?.Cycle</div></div></div></div>
    <div class="col-md-3 col-6"><div class="th-stat"><div class="th-stat-label">Users · Facilities</div><div class="th-stat-value" style="font-size: 1.2rem;">@ViewBag.UserCount · @facilities.Count</div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="th-card th-card-body h-100">
            <h2 class="th-section-title mb-3">Actions</h2>
            <div class="d-flex flex-wrap gap-2">
                @if (Model.Status != TenantStatus.Suspended)
                {
                    <form asp-action="Suspend" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Suspend this tenant? They lose all access until reactivated.')"><i class="bi bi-pause-circle"></i> Suspend</button>
                    </form>
                }
                else
                {
                    <form asp-action="Reactivate" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-sm btn-outline-success"><i class="bi bi-play-circle"></i> Reactivate</button>
                    </form>
                }
                <form asp-action="ExtendTrial" method="post" class="d-inline d-flex gap-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="number" name="days" value="14" min="1" max="365" class="form-control form-control-sm" style="width: 90px;" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-calendar-plus"></i> Extend trial</button>
                </form>
                <form asp-action="SetTeachingHospital" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="verified" value="@(!Model.IsTeachingHospital)" />
                    <button class="btn btn-sm btn-outline-info"><i class="bi bi-mortarboard"></i> @(Model.IsTeachingHospital ? "Remove teaching status" : "Mark as teaching hospital")</button>
                </form>
                @if (!string.IsNullOrEmpty(Model.CustomDomain))
                {
                    <form asp-action="ClearCustomDomain" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-sm btn-outline-warning" onclick="return confirm('Clear @Model.CustomDomain? Tenant will fall back to @(Model.Slug).thrivehealth.ng until they set a new one.')"><i class="bi bi-globe2"></i> Clear custom domain</button>
                    </form>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.CustomDomain))
            {
                <div class="mt-3 small">
                    <span class="text-muted">Custom domain:</span> <code>@Model.CustomDomain</code>
                    @if (Model.CustomDomainVerifiedAt.HasValue)
                    {
                        <span class="th-pill th-pill-success ms-1">Verified @Model.CustomDomainVerifiedAt?.ToString("dd MMM")</span>
                    }
                    else
                    {
                        <span class="th-pill th-pill-warning ms-1">Awaiting verification</span>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="th-card th-card-body h-100">
            <h2 class="th-section-title mb-3">Subscription</h2>
            @if (sub is null)
            {
                <p class="text-muted">No active subscription.</p>
            }
            else
            {
                <div class="row g-2 small">
                    <div class="col-6"><span class="text-muted">Plan:</span> <strong>@sub.Plan?.Name</strong></div>
                    <div class="col-6"><span class="text-muted">Cycle:</span> @sub.Cycle</div>
                    <div class="col-6"><span class="text-muted">Price:</span> @sub.PriceCurrency @sub.PriceAmount.ToString("N0")</div>
                    <div class="col-6"><span class="text-muted">Renews:</span> @(sub.CurrentPeriodEnd.ToString("dd MMM yyyy"))</div>
                </div>
            }
        </div>
    </div>
</div>

<h2 class="th-section-title mb-2">Payment history</h2>
<div class="th-card th-table-flush mb-4">
    <div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Method</th><th>Amount</th><th>Status</th><th>Reference</th><th>Submitted</th><th>Receipt</th></tr></thead>
        <tbody>
            @foreach (var p in payments)
            {
                <tr>
                    <td>@p.Method</td>
                    <td>@p.Currency @p.Amount.ToString("N0")</td>
                    <td><span class="th-pill th-pill-@(p.Status == PaymentReceiptStatus.Approved ? "success" : p.Status == PaymentReceiptStatus.Pending ? "warning" : "danger")">@p.Status</span></td>
                    <td class="small">@p.Reference</td>
                    <td class="small">@(p.SubmittedAt.ToString("dd MMM HH:mm"))</td>
                    <td>@if (!string.IsNullOrEmpty(p.ReceiptUrl)) { <a href="@p.ReceiptUrl" target="_blank" class="small">View</a> }</td>
                </tr>
            }
            @if (!payments.Any()) { <tr><td colspan="6" class="text-center py-3 text-muted">No payments yet.</td></tr> }
        </tbody>
    </table>
    </div>
</div>

<h2 class="th-section-title mb-2">Facilities</h2>
<div class="th-card th-table-flush">
    <div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Name</th><th>Code</th><th>Type</th><th>Beds</th><th>Created</th></tr></thead>
        <tbody>
            @foreach (var f in facilities)
            {
                <tr><td>@f.Name</td><td>@f.Code</td><td>@f.Type</td><td>@f.BedCapacity</td><td class="small">@(f.CreatedAt.ToString("dd MMM yyyy"))</td></tr>
            }
        </tbody>
    </table>
    </div>
</div>

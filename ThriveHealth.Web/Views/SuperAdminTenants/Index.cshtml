@model IReadOnlyList<ThriveHealth.Web.Models.Tenancy.Tenant>
@using ThriveHealth.Web.Models.Tenancy
@{
    ViewData["Title"] = "Tenants";
    string Tone(TenantStatus s) => s switch
    {
        TenantStatus.Trialing => "info",
        TenantStatus.Active => "success",
        TenantStatus.PendingPayment => "warning",
        TenantStatus.PastDue => "danger",
        TenantStatus.Suspended => "muted",
        TenantStatus.Cancelled => "muted",
        _ => "muted"
    };
}

<div class="th-page-head"><div>
    <h1 class="th-section-title">Tenants</h1>
    <p class="th-section-sub">Every hospital that has signed up to ThriveHealth.</p>
</div></div>

<form method="get" class="th-toolbar">
    <input type="text" name="q" value="@ViewBag.Q" placeholder="Search by name, slug, owner email…" class="form-control" style="flex: 1 1 220px;" />
    <select name="status" class="form-select" style="max-width: 220px;">
        <option value="">All statuses</option>
        @foreach (TenantStatus s in Enum.GetValues<TenantStatus>())
        {
            <option value="@((int)s)" selected="@(ViewBag.Status?.ToString() == s.ToString())">@s</option>
        }
    </select>
    <button class="btn btn-primary" aria-label="Search"><i class="bi bi-search"></i></button>
</form>

<div class="th-card th-table-flush">
    <div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Tenant</th><th>Owner</th><th>Status</th><th>Country</th><th>Trial ends</th><th>Created</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td><strong>@t.LegalName</strong><div class="small text-muted">@(t.CustomDomain ?? t.Slug + ".thrivehealth.ng")</div></td>
                    <td>@t.OwnerName<div class="small text-muted">@t.OwnerEmail</div></td>
                    <td><span class="th-pill th-pill-@Tone(t.Status)">@t.Status</span> @if (t.IsTeachingHospital) { <span class="th-pill th-pill-info ms-1">Teaching</span> }</td>
                    <td>@t.CountryCode · @t.CurrencyCode</td>
                    <td class="small">@t.TrialEndsAt?.ToString("dd MMM yyyy")</td>
                    <td class="small">@(t.CreatedAt.ToString("dd MMM HH:mm"))</td>
                    <td><a asp-action="Detail" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Open</a></td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="7" class="text-center py-4 text-muted">No tenants match.</td></tr> }
        </tbody>
    </table>
    </div>
</div>

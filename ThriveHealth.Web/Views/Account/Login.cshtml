@model ThriveHealth.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<style>
    .th-auth-form .input-group { position: relative; }
    .th-auth-form .input-group .form-control { padding-right: 44px; border-radius: var(--th-radius-sm) !important; }
    .th-auth-form .toggle-pw { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); background: transparent; border: 0; padding: 8px 12px; color: var(--th-text-muted); z-index: 5; cursor: pointer; }
    .th-auth-form .toggle-pw:hover { color: var(--th-text); }
    .th-auth-form .forgot-link { color: var(--th-link); font-size: 13px; font-weight: 500; }
    .th-auth-form .forgot-link:hover { text-decoration: underline; }
    .th-auth-divider { display: flex; align-items: center; gap: 12px; color: var(--th-text-faint); font-size: 12.5px; margin: 22px 0 14px; }
    .th-auth-divider::before, .th-auth-divider::after { content: ""; height: 1px; background: var(--th-border); flex: 1; }
    .th-auth-portal-link { text-align: center; font-size: 13px; color: var(--th-text-muted); }
    .th-auth-portal-link a { color: var(--th-link); font-weight: 500; }
    .th-auth-feature .desc { font-size: 12.5px; color: #c3cbd6; }
    .th-auth-feature { display: flex; align-items: flex-start; gap: 12px; }
    .th-auth-trust { font-size: 12.5px; color: #c3cbd6; display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 20px; }
    .th-auth-trust span { display: inline-flex; align-items: center; gap: 6px; }
    .th-auth-foot-copy { font-size: 12.5px; color: #c3cbd6; }
    .th-auth-mobile-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; margin-bottom: 20px; }
    @@media (max-width: 575.98px) {
        .th-auth-form-wrap { padding: 16px; }
        .th-auth-form { padding: 24px 20px; }
    }
</style>

<div class="th-auth">
    <div class="th-auth-art">
        <div class="th-auth-art-brand">
            <span class="th-logo"><i class="bi bi-heart-pulse-fill"></i></span>
            <div>
                <div class="fw-bold">ThriveHealth</div>
                <div style="font-size:12.5px;color:#c3cbd6;">Hospital management</div>
            </div>
        </div>

        <div class="th-auth-pitch">
            <h1>One source of truth for every patient, every visit, every naira.</h1>
            <p>Built for the realities of Nigerian healthcare — NHIA &amp; HMO claims, NIMC verification, NDPA-compliant audit, offline-resilient clinical workflows.</p>

            <div class="th-auth-features">
                <div class="th-auth-feature">
                    <i class="bi bi-shield-lock"></i>
                    <div>
                        <div class="value">Compliance</div>
                        <div class="desc">NDPA · NHIA · NHMIS</div>
                    </div>
                </div>
                <div class="th-auth-feature">
                    <i class="bi bi-broadcast"></i>
                    <div>
                        <div class="value">Resilience</div>
                        <div class="desc">Offline-first · live updates</div>
                    </div>
                </div>
                <div class="th-auth-feature">
                    <i class="bi bi-cash-stack"></i>
                    <div>
                        <div class="value">Revenue</div>
                        <div class="desc">Cash · POS · HMO · NHIA</div>
                    </div>
                </div>
                <div class="th-auth-feature">
                    <i class="bi bi-people"></i>
                    <div>
                        <div class="value">Care continuity</div>
                        <div class="desc">EMR · Lab · Pharmacy</div>
                    </div>
                </div>
            </div>

            <div class="th-auth-trust">
                <span><i class="bi bi-shield-check"></i> NDPR-compliant</span>
                <span><i class="bi bi-lock"></i> Encrypted in transit &amp; at rest</span>
                <span><i class="bi bi-clipboard2-check"></i> Audited access</span>
            </div>
        </div>

        <div class="th-auth-foot-copy">&copy; @DateTime.Now.Year ThriveHealth · v1.0</div>
    </div>

    <div class="th-auth-form-wrap">
        <div class="th-auth-form">
            <div class="th-auth-mobile-brand d-lg-none">
                <span class="th-logo"><i class="bi bi-heart-pulse-fill"></i></span> ThriveHealth
            </div>
            <h2>Welcome back</h2>
            <p class="subtitle">Sign in to your facility workspace.</p>

            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Work email</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus placeholder="you@hospital.ng" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <input id="th-pw" asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                        <button type="button" class="toggle-pw" id="th-pw-toggle" aria-label="Show password" tabindex="-1"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
                    </div>
                    <a class="forgot-link" href="#">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    Sign in <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            <div class="th-auth-divider">or</div>
            <div class="th-auth-portal-link">
                Are you a patient? <a asp-controller="Portal" asp-action="Login">Open the patient portal →</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var btn = document.getElementById('th-pw-toggle');
    var pw = document.getElementById('th-pw');
    if (!btn || !pw) return;
    btn.addEventListener('click', function () {
        var hidden = pw.type === 'password';
        pw.type = hidden ? 'text' : 'password';
        btn.querySelector('i').className = hidden ? 'bi bi-eye-slash' : 'bi bi-eye';
        btn.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
    });
})();
</script>
<partial name="_ValidationScriptsPartial" />
}
